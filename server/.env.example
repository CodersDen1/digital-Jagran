# Copy to server/.env for your own setup. Existing .env files are never replaced.
NODE_ENV=development
HOST=127.0.0.1
PORT=5001
PUBLIC_ORIGIN=http://localhost:5001
DATA_STORE=file
SEED_DEMO=true
# DATA_FILE=./data/newsroom.json
# Set both for your own editor account. Defaults are available only for local development.
# ADMIN_EMAIL=editor@example.com
# ADMIN_PASSWORD=choose-a-unique-long-password
# Opt in to the existing MongoDB instead of the isolated local file:
# DATA_STORE=mongo
# MONGODB_URI=mongodb://127.0.0.1:27017/digital_jagaran
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
