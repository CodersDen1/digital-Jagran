{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "publicOrigin",
    "existingSecret",
    "trustProxy"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "publicOrigin": {
      "type": "string",
      "pattern": "^https://[^/]+$"
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "trustProxy": {
      "type": "string",
      "minLength": 1
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 100
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 35,
      "maximum": 120
    },
    "mongo": {
      "type": "object",
      "properties": {
        "maxPoolSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "minPoolSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "waitQueueTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        },
        "operationTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 8000
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 2
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 20,
          "maximum": 95
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mongoCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]+$"
          }
        },
        "mongoPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
